{
  "name": "kultura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y:build": "node tests/e2e/a11y/build.cjs",
    "test:a11y": "playwright test -c tests/e2e/a11y/playwright.a11y.config.ts",
    "test:all": "npm run type-check && npm run lint && npm run test && npm run test:e2e",
    "verify": "npm run build && npm run test:all"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.169.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
