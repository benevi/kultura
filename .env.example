# =============================================================================
# KULTURA — plantilla de variables de entorno
# Copia a .env.local y rellena. Sin valores reales aquí (este archivo SÍ va a git).
# Validación: src/lib/env.ts (Zod). Fail-fast en arranque vía instrumentation.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUERIDAS (esquema Zod — el server no arranca sin ellas)
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (pública, se inlinea en el bundle cliente)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key de Supabase (pública, RLS protege los datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Service role key de Supabase — server-only, bypassa RLS. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# API key de TMDB (películas + series) — server-only
TMDB_API_KEY=<tmdb-api-key>

# API key de RAWG (videojuegos) — server-only
RAWG_API_KEY=<rawg-api-key>

# -----------------------------------------------------------------------------
# 2. OPCIONALES (la app funciona sin ellas; string vacío = ausente)
# -----------------------------------------------------------------------------

# Base URL pública del sitio (SEO / og:url). Opcional.
NEXT_PUBLIC_SITE_URL=https://<dominio-produccion>

# API key de Anthropic Claude (recomendaciones IA, claude-haiku-4-5) — server-only.
# Debe empezar por "sk-ant-". Opcional: sin ella, las recomendaciones IA no funcionan.
ANTHROPIC_API_KEY=sk-ant-<anthropic-api-key>

# API key de ComicVine (cómics) — server-only. Opcional: sin ella, la familia
# "cómic" de Descubrir/búsqueda/ficha queda vacía (el resto de la app funciona).
COMICVINE_KEY=<comicvine-api-key>

# API key de Google Books (libros) — server-only. Opcional en el esquema: la API
# pública responde sin key, PERO su cuota anónima va por IP de salida y suele
# estar a 0 en IPs de cloud (verificado 2026-09-12: 429 RESOURCE_EXHAUSTED con
# quota_limit_value=0). En producción, ponerla. Ver src/lib/api/googlebooks.ts.
GOOGLE_BOOKS_KEY=<google-books-api-key>

# -----------------------------------------------------------------------------
# 2b. OBSERVABILIDAD (C1/C2) — opcional, la app funciona sin ellas.
#     Sin NEXT_PUBLIC_SENTRY_DSN, el SDK de Sentry queda inactivo (no-op, sin
#     red, sin throw) y el logger de src/lib/logger.ts nunca intenta reenviar.
#     Leídas directamente por sentry.*.config.ts y next.config.mjs — no pasan
#     por el esquema Zod de src/lib/env.ts (config de infra, no de la app).
# -----------------------------------------------------------------------------

# DSN del proyecto Sentry. Pública a propósito (así funciona Sentry): identifica
# el proyecto, no autentica nada. Crear proyecto "Next.js" en sentry.io → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>

# Solo necesarias en el build de producción (Vercel) para subir source maps legibles.
# Sin ellas, Sentry sigue capturando errores — solo verás el bundle minificado en vez
# del stack trace original. Generar SENTRY_AUTH_TOKEN en sentry.io → Settings → Auth Tokens
# (scope project:releases).
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>
SENTRY_AUTH_TOKEN=<sentry-auth-token>

# -----------------------------------------------------------------------------
# 2c. SECRETOS DE SERVIDOR (opcionales en local; en producción, todos puestos)
#     Generar cada uno con: openssl rand -hex 32. Nunca con prefijo NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Lo manda Vercel Cron a /api/cron/daily. Si falta, el cron solo hace el
# keep-alive: la purga de cuentas borradas no se ejecuta (y queda un error en el log).
CRON_SECRET=<secreto-cron>

# Protege POST /api/revalidate (vaciar etiquetas de caché a mano). Si falta,
# la ruta responde 404 y no hay forma de vaciar la caché sin desplegar.
REVALIDATE_SECRET=<secreto-revalidate>

# Firma los enlaces para compartir una valoración. Si falta, se usa
# INVITE_SECRET y, si tampoco está, la service role. Rotarlo invalida los enlaces ya compartidos.
SHARE_SECRET=<secreto-share>

# Firma los enlaces de invitación. Si falta, se usa la service role (rotar
# la service role invalidaría las invitaciones).
INVITE_SECRET=<secreto-invite>

# Firma los enlaces de baja del correo (≥ 32 caracteres). Si falta, el correo
# semanal no se envía y los enlaces de baja no se pueden verificar.
EMAIL_TOKEN_SECRET=<secreto-email-de-32-o-mas-caracteres>

# Email de la cuenta demo de solo lectura (la crea scripts/seed-demo.ts). Si
# falta, no se pinta «Ver la demo» y /api/auth/demo redirige al login.
DEMO_USER_EMAIL=<email-cuenta-demo>

# -----------------------------------------------------------------------------
# 2d. LÍMITE DE PETICIONES (Redis de Upstash). Vale cualquiera de las dos
#     parejas; la integración de Upstash en Vercel crea la KV_REST_API_*.
#     Si faltan (o Redis no responde), el límite cae a memoria por instancia:
#     la API sigue funcionando, pero el límite es débil.
# -----------------------------------------------------------------------------

KV_REST_API_URL=https://<instancia>.upstash.io
KV_REST_API_TOKEN=<upstash-token>
# UPSTASH_REDIS_REST_URL=https://<instancia>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# -----------------------------------------------------------------------------
# 2e. CORREO (Resend). Hoy apagado en producción (Q22): sin estas variables,
#     las denuncias solo llegan a Sentry y no se envía ningún correo.
# -----------------------------------------------------------------------------

# Clave de Resend. Si falta, no se envía ningún correo (ni moderación ni semanal).
RESEND_API_KEY=<resend-api-key>

# Buzón que recibe las denuncias. Si falta, la denuncia se guarda y va a Sentry, sin correo.
MODERATION_EMAIL=<buzon-de-moderacion>

# Remitente de los correos de moderación. Si falta, el de pruebas de Resend
# (onboarding@resend.dev, que solo entrega al dueño de la cuenta de Resend).
MODERATION_EMAIL_FROM="KULTURA <hola@<dominio>>"

# Remitente del correo semanal. Si falta, el semanal no se envía.
EMAIL_FROM="KULTURA <hola@<dominio>>"

# Solo para probar el semanal: correos separados por comas. Si falta, todos
# pueden apuntarse; si está, solo esas cuentas ven la opción.
# WEEKLY_EMAIL_ONLY=<correo1>,<correo2>

# -----------------------------------------------------------------------------
# 2f. TOPES Y AJUSTES (todos opcionales; si faltan, el valor por defecto)
# -----------------------------------------------------------------------------

# Llamadas a la IA al día (recomendaciones + traducciones). Por defecto 100. 0 apaga la IA.
# AI_DAILY_CALL_CAP=100

# Correos de moderación al día en total. Por defecto 80 (Resend Free = 100/día).
# MODERATION_EMAIL_DAILY_CAP=80

# Correos semanales por ejecución del cron. Por defecto 50.
# WEEKLY_EMAIL_DAILY_CAP=50

# Correos de confirmación del alta al semanal al día (1–100). Por defecto 20.
# WEEKLY_EMAIL_OPTIN_DAILY_CAP=20

# Contacto que va en el User-Agent de las llamadas a proveedores. Si falta,
# solo la URL del proyecto.
# PROVIDER_CONTACT=<email-o-url-de-contacto>

# Contrato de las respuestas de proveedores: "log" (por defecto: avisa y sirve
# igual) o "enforce" (lanza y no guarda en caché).
# PROVIDER_CONTRACT_MODE=log

# Service worker (PWA). "0" lo des-registra en los navegadores (tras redeploy).
# Si falta, activado.
# NEXT_PUBLIC_PWA_SW=1

# -----------------------------------------------------------------------------
# 2g. BANDERAS (docs/banderas.json; el CI comprueba que coinciden con el código)
#     Solo "1" enciende; si falta, apagada.
# -----------------------------------------------------------------------------

# Resumen semanal por email. Apagada (Q22). Necesita además RESEND_API_KEY,
# EMAIL_FROM y EMAIL_TOKEN_SECRET; si falta alguna, el cron no envía.
WEEKLY_EMAIL=0

# Notificaciones push. Apagada (Q14). Necesita además las claves de abajo; si
# falta alguna o el par de claves no casa, no se envía nada y nada falla.
PUSH_ENABLED=0
# Par de claves: npx web-push generate-vapid-keys. Nunca con NEXT_PUBLIC_.
# VAPID_PUBLIC_KEY=<base64url-65-bytes>
# VAPID_PRIVATE_KEY=<base64url-32-bytes>
# Contacto para los servicios push (mailto: o https:). Si falta, el de KULTURA.
# VAPID_SUBJECT=mailto:<contacto>
# ≥ 32 caracteres; el mismo valor va en Vault (push_dispatch_secret).
# PUSH_DISPATCH_SECRET=<secreto-push>
# Opcional; si se pone, igual que VAPID_PUBLIC_KEY.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=<base64url-65-bytes>

# Interruptor de emergencia: "1" apaga la analítica propia. Si falta, encendida.
# ANALYTICS_DISABLED=1

# -----------------------------------------------------------------------------
# 3. SOLO TESTS (no necesarias para desarrollo normal; viven en scripts y tests,
#    no pasan por el esquema Zod y no rompen el build si faltan)
# -----------------------------------------------------------------------------

# Proyecto Supabase separado para tests de integración (kultura-test)
SUPABASE_TEST_URL=https://<test-project-ref>.supabase.co
SUPABASE_TEST_ANON_KEY=<test-anon-key>
# service_role del proyecto de test — solo migraciones/seed, nunca en código de app
SUPABASE_TEST_SERVICE_ROLE_KEY=<test-service-role-key>

# Usuarios seedeados para specs E2E (Playwright)
TEST_USER_EMAIL=<email-usuario-a>
TEST_USER_PASSWORD=<password-compartida-a-y-b>
TEST_USER_B_EMAIL=<email-usuario-b>
# UUID del grupo seedeado (rellenar tras correr el seed B3.5e-2)
TEST_GROUP_ID=<uuid-grupo-seed>

# Token para GET /api/health?deep=1 (cabecera Authorization: Bearer o ?token=).
# Sin él, el chequeo profundo responde 401. Generar con: openssl rand -hex 32
HEALTH_DEEP_TOKEN=<token-aleatorio>
