exports[`ListDetail — HTML > visitante de una lista privada, de varios formatos y sin plantilla 1`] = `"<div class="flex flex-col gap-10"><header class="flex items-start justify-between gap-3 flex-wrap"><div><h1 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-text-primary leading-tight">Maratón de terror</h1><div class="flex items-center gap-3 mt-3 flex-wrap"><span class="text-meta text-text-tertiary"><span class="font-semibold text-text-secondary">lists.mediaTypeMixed</span> · lists.itemCount(3)</span></div></div><div class="flex items-center gap-3 flex-shrink-0"></div></header><section><div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-xl font-bold text-text-primary">lists.itemsTitle<span class="ml-2 text-sm font-body font-medium text-text-secondary">3</span></h2></div><ol class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-5" aria-label="lists.itemsTitle"><li class="relative group flex flex-col gap-2"><div data-media-card="movie_1">Alien</div><p data-note-list="l1" data-note-item="i1" data-editable="false">La mejor</p></li><li class="relative group flex flex-col gap-2"><div data-media-card="movie_2">Halloween</div></li><li class="relative group flex flex-col gap-2"><div class="aspect-[2/3] rounded-2xl flex items-center justify-center bg-[linear-gradient(155deg,var(--surface2),var(--surface))]"><span class="text-xs text-text-secondary text-center px-1 line-clamp-3">movie_3</span></div></li></ol></section></div>"`;
