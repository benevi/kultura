{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3187/es",
        "http://localhost:3187/es/best/movie/2026",
        "http://localhost:3187/es/privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/es/(best|privacy)",
          "aggregationMethod": "median-run",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        },
        {
          "matchingUrlPattern": "/es$",
          "aggregationMethod": "median-run",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 163840 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./test-results/lhci"
    }
  }
}
